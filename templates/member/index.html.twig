{% extends 'base.html.twig' %}

{% block title %}Membres{% endblock %}

{% block header_title %}Membres{% endblock %}
{% block header_subtitle %}Les collectionneurs de The Turning Sound{% endblock %}

{% block body %}
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nom d'utilisateur</th>
                <th>Email</th>
                <th>Bibliothèque</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for member in members %}
                <tr>
                    <td>
                        {% dump member %}
                        {{ member.username }}
                    </td>
                    <td>{{ member.email }}</td>
                    <td><a href="{{ path('library_show', {'id': member.library.id}) }}">{{ member.library.name }}</a></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-dark" href="{{ path('member_show', {'username': member.username}) }}">Voir</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-muted">Aucun membre.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
