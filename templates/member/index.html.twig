{% extends 'base.html.twig' %}

{% block title %}Membres{% endblock %}

{% block body %}
    <h1>Liste des membres</h1>
    <ul>
        <table class="table">
            {% for member in members %}
                <tr>
                    {%  dump member %}
                    <th><a href="{{ path('member_show', {'username' : member.username}) }}">{{ member.username }}</a></th>
                    <th>{{ member.email }}</th>
                    <th><a href="{{ path('library_show', {'id' : member.library.id}) }}">Lien vers sa librarie</a></th>
                </tr>
            {% endfor %}
        </table>
    </ul>

{% endblock %} {# body #}
