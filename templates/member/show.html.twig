{% extends 'base.html.twig' %}

{% block title %}Membre {{ member.username }}{% endblock %}

{% block body %}
    <h1>{{ member.username }}</h1>

    <table class="table">
        <tbody>
        <tr>
            <th>Nom d'utilisateur</th>
            <td>{{ member.username }}</td>
        </tr>
        <tr>
            <th>Email</th>
            <td>{{ member.email }}</td>
        </tr>
        <tr>
            <th>Biographie</th>
            <td>{{ member.biography ?? 'Aucune biographie' }}</td>
        </tr>
        <tr>
            <th>Librairie</th>
            <td><a href="{{ path('library_show', {'id' : member.library.id}) }}">{{ member.library.name }}</a></td>
        </tr>
        <tr>
            <th>Bacs</th>
            <td>
                <table class="table">
                    <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for bac in bacs %}
                        <tr>
                            {% dump bac %}
                                <td>{{ bac.name }}</td>
                                <td>{{ bac.description }}</td>
                                <td>
                                    <a href="{{ path('app_bac_show', {'id': bac.id}) }}">show</a>
                                    <a href="{{ path('app_bac_edit', {'id': bac.id}) }}">edit</a>
                                </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </td>
        </tr>
        </tbody>
    </table>

    <a href="{{ path('app_bac_new', {'id': member.id}) }}"> Ajouter un nouveau bac</a>
    <a href="{{ path('member_list') }}">Retour à la liste</a>

{% endblock %} {# body #}
