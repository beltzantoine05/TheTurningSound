{% extends 'base.html.twig' %}

{% block title %}Modifier {{ vinyl.title }}{% endblock %}

{% block header_title %}Modifier le vinyle{% endblock %}
{% block header_subtitle %}{{ vinyl.title }} · {{ vinyl.artist ?? 'Artiste inconnu' }}{% endblock %}

{% block body %}
    <div class="mb-5">
        {{ include('vinyl/_form.html.twig') }}
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-dark" href="{{ path('app_vinyl_show', {'id': vinyl.id}) }}">Retour au vinyle</a>
        {{ include('vinyl/_delete_form.html.twig') }}
    </div>
{% endblock %}
