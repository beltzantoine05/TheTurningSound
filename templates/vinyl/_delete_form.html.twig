<form method="post" action="{{ path('app_vinyl_delete', {'id': vinyl.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer ce vinyle ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ vinyl.id) }}">
    <button class="btn btn-outline-danger">Supprimer</button>
</form>
