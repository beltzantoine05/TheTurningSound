{% extends 'base.html.twig' %}

{% block title %}Nouveau vinyle{% endblock %}

{% block header_title %}Nouveau vinyle{% endblock %}
{% block header_subtitle %}Dans {{ vinyl.library.name }}{% endblock %}

{% block body %}
    <div class="mb-5">
        {{ include('vinyl/_form.html.twig', {'button_label': 'Ajouter le vinyle'}) }}
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-dark" href="{{ path('library_show', {'id': vinyl.library.id}) }}">Retour à la bibliothèque</a>
    </div>
{% endblock %}
