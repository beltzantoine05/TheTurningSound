{% extends 'base.html.twig' %}

{% block title %}Vinyl{% endblock %}

{% block body %}
    <h1>Vinyl</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Artist</th>
                <td>{{ vinyl.artist }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ vinyl.title }}</td>
            </tr>
            <tr>
                <th>Year</th>
                <td>{{ vinyl.year }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ vinyl.type }}</td>
            </tr>
            <tr>
                <th>Label</th>
                <td>{{ vinyl.label }}</td>
            </tr>
            <tr>
                <th>ProdCountry</th>
                <td>{{ vinyl.prodCountry }}</td>
            </tr>
            <tr>
                <th>ProdYear</th>
                <td>{{ vinyl.prodYear }}</td>
            </tr>
            <tr>
                <th>Signed</th>
                <td>{{ vinyl.signed ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ vinyl.description }}</td>
            </tr>
            <tr>
                <th>Cover</th>
                <td>
                    {% if vinyl.imageName %}
                        <img src="{{ vich_uploader_asset(vinyl, 'imageFile') }}"
                             alt="Pochette de {{ vinyl.title }}"
                             class="img-fluid"
                             style="width: 60%">
                    {% else %}
                        <p>Aucune pochette pour ce vinyle </p>
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>


    <a href="{{ path('app_vinyl_edit', {'id': vinyl.id}) }}">edit</a>

    <a href="{{ path('library_show' ,{'id': vinyl.library.id}) }}">Retour à la librarie</a>

    {{ include('vinyl/_delete_form.html.twig') }}
{% endblock %}
