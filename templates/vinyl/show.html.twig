{% extends 'base.html.twig' %}

{% block title %}{{ vinyl.title }}{% endblock %}

{% block header_title %}{{ vinyl.title }}{% endblock %}
{% block header_subtitle %}{{ vinyl.artist ?? 'Artiste inconnu' }}{% endblock %}

{% block body %}
    {% dump vinyl %}

    {{ include('vinyl/_details.html.twig') }}

    <div class="d-flex gap-2">
        <a class="btn btn-outline-dark" href="{{ path('library_show', {'id': vinyl.library.id}) }}">Retour à la bibliothèque</a>
        {# Actions réservées au propriétaire du vinyle ou à un administrateur #}
        {% if is_granted('ROLE_ADMIN') or app.user is same as(vinyl.library.member) %}
            <a class="btn btn-dark" href="{{ path('app_vinyl_edit', {'id': vinyl.id}) }}">Modifier</a>
            {{ include('vinyl/_delete_form.html.twig') }}
        {% endif %}
    </div>
{% endblock %}
