{% extends 'base.html.twig' %}

{% block title %}Vinyles{% endblock %}

{% block header_title %}Vinyles{% endblock %}
{% block header_subtitle %}Tous les vinyles des bibliothèques{% endblock %}

{% block body %}
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Titre</th>
                <th>Artiste</th>
                <th>Année</th>
                <th>Type</th>
                <th>Bibliothèque</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for vinyl in vinyls %}
                <tr>
                    <td>{{ vinyl.title }}</td>
                    <td>{{ vinyl.artist ?? '-' }}</td>
                    <td>{{ vinyl.year ?? '-' }}</td>
                    <td>{{ vinyl.type ?? '-' }}</td>
                    <td><a href="{{ path('library_show', {'id': vinyl.library.id}) }}">{{ vinyl.library.name }}</a></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-dark" href="{{ path('app_vinyl_show', {'id': vinyl.id}) }}">Voir</a>
                        {% if is_granted('ROLE_ADMIN') or app.user is same as(vinyl.library.member) %}
                            <a class="btn btn-sm btn-dark" href="{{ path('app_vinyl_edit', {'id': vinyl.id}) }}">Modifier</a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-muted">Aucun vinyle.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
