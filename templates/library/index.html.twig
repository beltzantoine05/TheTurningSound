{% extends 'base.html.twig' %}

{% block title %}Bibliothèques{% endblock %}

{% block header_title %}Bibliothèques{% endblock %}
{% block header_subtitle %}Les collections de vinyles des membres{% endblock %}

{% block body %}
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Propriétaire</th>
                <th>Vinyles</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for library in libraries %}
                <tr>
                    <td>
                        {% dump library %}
                        {{ library.name }}
                    </td>
                    <td>{{ library.member.username }}</td>
                    <td>{{ library.vinyls|length }}</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-dark" href="{{ path('library_show', {'id': library.id}) }}">Voir</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-muted">Aucune bibliothèque.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
