{% extends 'base.html.twig' %}

{% block title %}Librairie {{ library.name }}{% endblock %}

{% block body %}
    <h1>{{ library.name }}</h1>

    {% dump library %}

    <table class="table">
        <tbody>
        <tr>
            <th>Nom</th>
            <td>{{ library.name }}</td>
        </tr>
        <tr>
            <th>Propriétaire</th>
            <td><a href="{{ path('member_show', {'username' : library.member.username}) }}">{{ library.member.username }}</a></td>
        </tr>
        <tr>
            <th>Nombre de vinyles</th>
            <td>{{ vinyls|length }}</td>
        </tr>
        </tbody>
    </table>

    <h2>Vinyles de la librairie</h2>

    <table class="table">
        <thead>
        <tr>
            <th>Titre</th>
            <th>Artiste</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        {% for vinyl in vinyls %}
            <tr>
                {% dump vinyl %}
                <td>{{ vinyl.title }}</td>
                <td>{{ vinyl.artist ?? '-' }}</td>
                <td><a href="{{ path('app_vinyl_show', {'id' : vinyl.id}) }}">Voir le vinyle</a></td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucun vinyle dans cette librairie</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('library_list') }}">Retour à la liste</a>

{% endblock %} {# body #}
