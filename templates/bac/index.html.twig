{% extends 'base.html.twig' %}

{% block title %}Bacs publics{% endblock %}

{% block header_title %}Bacs publics{% endblock %}
{% block header_subtitle %}Les sélections partagées par les membres{% endblock %}

{% block body %}
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Description</th>
                <th>Propriétaire</th>
                <th>Vinyles</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for bac in bacs %}
                <tr>
                    <td>
                        {% dump bac %}
                        {{ bac.name }}
                    </td>
                    <td>{{ bac.description ?? '-' }}</td>
                    <td>{{ bac.owner.username }}</td>
                    <td>{{ bac.vinyls|length }}</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-dark" href="{{ path('app_bac_show', {'id': bac.id}) }}">Voir</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-muted">Aucun bac public pour le moment.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
