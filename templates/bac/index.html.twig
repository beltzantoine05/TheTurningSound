{% extends 'base.html.twig' %}

{% block title %}Bac index{% endblock %}

{% block body %}
    <h1>Tous les bacs</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for bac in bacs %}
            <tr>
                {% dump bac %}
                <td>{{ bac.name }}</td>
                <td>{{ bac.description }}</td>
                <td>
                    <a href="{{ path('app_bac_show', {'id': bac.id}) }}">show</a>
                    <a href="{{ path('app_bac_edit', {'id': bac.id}) }}">edit</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
