{% extends 'base.html.twig' %}

{% block title %}Nouveau bac{% endblock %}

{% block header_title %}Nouveau bac{% endblock %}
{% block header_subtitle %}Pour {{ bac.owner.username }}{% endblock %}

{% block body %}
    <div class="mb-5">
        {{ include('bac/_form.html.twig', {'button_label': 'Créer le bac'}) }}
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-dark" href="{{ path('member_show', {'username': bac.owner.username}) }}">Retour au membre</a>
    </div>
{% endblock %}
