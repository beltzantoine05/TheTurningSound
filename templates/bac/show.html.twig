{% extends 'base.html.twig' %}

{% block title %}{{ bac.name }}{% endblock %}

{% block header_title %}{{ bac.name }}{% endblock %}
{% block header_subtitle %}{{ bac.description ?? 'Aucune description' }}{% endblock %}

{% block body %}
    <h2 class="h4 mb-3">Caractéristiques</h2>
    <table class="table mb-5">
        <tbody>
            <tr>
                <th scope="row">Propriétaire</th>
                <td>
                    {% if app.user %}
                        <a href="{{ path('member_show', {'username': bac.owner.username}) }}">{{ bac.owner.username }}</a>
                    {% else %}
                        {{ bac.owner.username }}
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th scope="row">Bibliothèque</th>
                <td>
                    {% if app.user %}
                        <a href="{{ path('library_show', {'id': bac.owner.library.id}) }}">{{ bac.owner.library.name }}</a>
                    {% else %}
                        {{ bac.owner.library.name }}
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th scope="row">Visibilité</th>
                <td>
                    {% if bac.public %}
                        <span class="badge bg-success">Public</span>
                    {% else %}
                        <span class="badge bg-secondary">Privé</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th scope="row">Description</th>
                <td>{{ bac.description ?? '-' }}</td>
            </tr>
        </tbody>
    </table>

    <h2 class="h4 mb-3">Vinyles du bac ({{ bac.vinyls|length }})</h2>
    <table class="table table-hover mb-5">
        <thead>
            <tr>
                <th>Titre</th>
                <th>Artiste</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for vinyl in bac.vinyls %}
                <tr>
                    <td>
                        {% dump vinyl %}
                        {{ vinyl.title }}
                    </td>
                    <td>{{ vinyl.artist ?? '-' }}</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-dark" href="{{ path('app_bac_vinyl_show', {'vinyl_id': vinyl.id, 'bac_id': bac.id}) }}">Voir</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-muted">Ce bac ne contient aucun vinyle.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-dark" href="{{ path('app_bac_index') }}">Retour à la liste</a>
        {# Actions réservées au propriétaire du bac ou à un administrateur #}
        {% if is_granted('ROLE_ADMIN') or (app.user and app.user is same as(bac.owner)) %}
            <a class="btn btn-dark" href="{{ path('app_bac_edit', {'id': bac.id}) }}">Modifier</a>
            {{ include('bac/_delete_form.html.twig') }}
        {% endif %}
    </div>
{% endblock %}
